# ─── Backend Config ────────────────────────────────────────────────────────────
# SQLite (default) — change to PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/incident_intelligence
DATABASE_URL=sqlite+aiosqlite:///./incident_intelligence.db

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend port (used when running directly with uvicorn)
PORT=8000

# ─── Frontend Config ───────────────────────────────────────────────────────────
# URL that the browser uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal server-side URL for SSR calls within Docker (set to container name)
BACKEND_URL=http://backend:8000
